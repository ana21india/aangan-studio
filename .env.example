# Copy this file to .env.local and fill in the values. Never commit .env.local.
# On Vercel, enter the same names under Project > Settings > Environment Variables.

# --- Database (Neon Postgres): the pooled connection string from the Neon dashboard
DATABASE_URL=

# --- Dashboard login (see DECISIONS.md D-018)
AUTH_SECRET=
ADMIN_EMAILS=

# --- Gemini (post-call extraction and scoring only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Voice provider: mock (replays test transcripts) or vaani
VOICE_PROVIDER=mock

# --- Vaani AI
VAANI_API_KEY=
VAANI_WEBHOOK_SECRET=
VAANI_AGENT_ID=

# --- Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DESIGNERS_CHAT_ID=
TELEGRAM_FRONTDESK_CHAT_ID=

# --- Timed follow-ups: a long random string. Also add it, and APP_URL, as GitHub repository secrets.
CRON_SECRET=

# --- Cal.com
CALCOM_BOOKING_URL=https://cal.com/ananta-khandelwal-0lbpsm/design-consultation
CALCOM_WEBHOOK_SECRET=

# --- HubSpot
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PIPELINE_ID=
HUBSPOT_STAGE_NEW=
HUBSPOT_STAGE_BOOKED=

# --- App
APP_BASE_URL=http://localhost:3000

# --- Unit costs in INR (fill from each vendor's price page)
COST_VAANI_PER_MIN_INR=
COST_GEMINI_PER_1M_INPUT_TOKENS_INR=
COST_GEMINI_PER_1M_OUTPUT_TOKENS_INR=
COST_SMS_PER_MESSAGE_INR=0
# Fixed monthly plans as JSON, e.g. {"vaani":0,"supabase":0,"vercel":0,"hubspot":0,"calcom":0}
COST_FIXED_MONTHLY_INR={}

# Behaviour settings (PRICING_MODE, AGENT_ACTIVE_HOURS, QUALIFIED_THRESHOLD, retention, etc.)
# live in the database `config` table, not here. See db/migrations/0001_initial_schema.sql.

# --- HubSpot links in the dashboard
HUBSPOT_PORTAL_ID=
HUBSPOT_APP_URL=https://app-na2.hubspot.com
